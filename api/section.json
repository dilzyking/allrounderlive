{
  "schema_version": 2,
  "app": "MatchDekho",
  "page": "home",
  "api_base_url": "https://api.example.com",

  "settings": {
    "refresh_on_open": true,
    "default_cache_seconds": 300,
    "loading_style": "skeleton",
    "hide_empty_sections": true,
    "auto_place_sections_in_navigation": true,
    "default_image_fit": "cover",
    "default_image_position": "center",
    "search": {
      "enabled": true,
      "include_enabled_sections_only": true,
      "search_content_via_section_endpoints": true,
      "deduplicate_by_item_id": true
    }
  },

  "navigation": {
    "tabs": [
      {
        "id": "home",
        "title": "Home",
        "order": 1
      },
      {
        "id": "live",
        "title": "Live",
        "order": 2
      },
      {
        "id": "sports",
        "title": "Sports",
        "order": 3
      },
      {
        "id": "discover",
        "title": "Discover",
        "order": 4
      }
    ],
    "unknown_tab_behavior": "hide_section"
  },

  "sections": [
    {
      "id": "featured",
      "title": "Featured",
      "subtitle": null,
      "enabled": true,
      "order": 1,
      "section_type": "hero_carousel",
      "content_type": "mixed",

      "data": {
        "source": "api",
        "endpoint": "/home/featured",
        "cache_seconds": 120,
        "pagination": false
      },

      "card": {
        "orientation": "landscape",
        "aspect_ratio": "16:9",
        "width_mode": "screen_fraction",
        "width_value": 0.96,
        "height_dp": 255,
        "image_fit": "cover",
        "image_position": "top",
        "corner_radius_dp": 18
      },

      "carousel": {
        "enabled": true,
        "auto_slide": true,
        "interval_ms": 5000,
        "transition_ms": 1250,
        "animation": "focus_scale",
        "side_preview_dp": 10,
        "side_scale": 0.92,
        "infinite_loop": true
      },

      "display": {
        "show_header": false,
        "show_view_all": true,
        "max_items": 10
      },

      "ads": {
        "enabled": false,
        "placement_id": null
      },

      "navigation": {
        "tab_ids": ["home"],
        "use_section_order": true
      },

      "view_all": {
        "enabled": true,
        "auto_create_page": true,
        "route": "/section/featured",
        "page_title": "Featured",
        "layout": "grid",
        "use_section_data_source": true,
        "pagination": true
      },

      "search": {
        "enabled": true,
        "include_items": true,
        "result_card_style": "section_card",
        "search_fields": [
          "title",
          "subtitle",
          "tags"
        ]
      }
    },

